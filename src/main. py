            tbl_lbl.pack(anchor=tk.W, pady=(5, 8))

            tbl_frame = tk.Frame(content_container, bg=self.C_CARD)
            tbl_frame.pack(fill=tk.BOTH, expand=True, pady=(0, 10))

            cols = ("Name", "Class Level", "Overall Score", "Weak Topics Identified")
            class_tree = ttk.Treeview(tbl_frame, columns=cols, show="headings", height=7)

            for c in cols:
                class_tree.heading(c, text=c)

            class_tree.column("Name", width=160, anchor=tk.W)
            class_tree.column("Class Level", width=100, anchor=tk.CENTER)
            class_tree.column("Overall Score", width=120, anchor=tk.CENTER)
            class_tree.column("Weak Topics Identified", width=420, anchor=tk.W)

            # Populate table only with students of the selected class
            same_class_students = [s for s in self.engine.students if s.student_class == selected_cls]

            for st in same_class_students:
                pct = st.get_overall_percentage()
                _, weak_list = st.get_topic_breakdown()
                weak_str = ", ".join([f"{subj}: {topic}" for subj, topic, _ in weak_list]) if weak_list else "None (Mastered)"
                class_tree.insert("", tk.END, values=(st.name, st.student_class, f"{pct:.1f}%", weak_str))

            class_tree.pack(fill=tk.BOTH, expand=True)

        class_filter_cb.bind("<<ComboboxSelected>>", refresh_class_data)
        refresh_class_data()


