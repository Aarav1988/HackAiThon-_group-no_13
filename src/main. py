            Resource("R148", "Class 10", "SST", "History", "Non-Cooperation Movement & Salt March 1930", "https://www.youtube.com/watch?v=VEZqf8115xI")
        ])

    def _seed_sample_students(self):
        """Seeds 3-4 sample student records containing specific names (Aditya, Avinash, Priya, Aarti) for every class (1 to 10)."""
        names_pool = ["Aditya", "Avinash", "Priya", "Aarti"]
        
        for c_num in range(1, 11):
            cls_name = f"Class {c_num}"
            
            # Retrieve available questions for this class to construct valid assessment records
            cls_questions = self.get_questions_for_class(cls_name)
            if not cls_questions:
                continue

            # Map questions by topic
            topic_map = {}
            for q in cls_questions:
                key = (q.subject, q.topic)
                if key not in topic_map:
                    topic_map[key] = 0
                topic_map[key] += 1

            topics = list(topic_map.keys())

            # Seed student 1: Aditya (Weak in 1st topic)
            st1 = Student(f"Aditya", cls_name)
            for idx, (subj, top) in enumerate(topics):
                max_m = topic_map[(subj, top)]
                scored = 0 if idx == 0 else max_m # Guaranteed weak topic
                st1.add_assessment(Assessment(subj, top, max_m, scored))
            self.students.append(st1)

            # Seed student 2: Avinash (Weak in 2nd topic)
            st2 = Student(f"Avinash", cls_name)
            for idx, (subj, top) in enumerate(topics):
                max_m = topic_map[(subj, top)]
                scored = 0 if idx == 1 else max_m # Guaranteed weak topic
                st2.add_assessment(Assessment(subj, top, max_m, scored))
            self.students.append(st2)

            # Seed student 3: Priya (Weak in 3rd topic)
            st3 = Student(f"Priya", cls_name)
            for idx, (subj, top) in enumerate(topics):
                max_m = topic_map[(subj, top)]
                scored = 0 if idx == 2 else max_m # Guaranteed weak topic
                st3.add_assessment(Assessment(subj, top, max_m, scored))
            self.students.append(st3)

            # Seed student 4: Aarti (Weak in 4th topic if available, else 1st)
            st4 = Student(f"Aarti", cls_name)
            target_weak_idx = 3 if len(topics) > 3 else 0
            for idx, (subj, top) in enumerate(topics):
                max_m = topic_map[(subj, top)]
                scored = 0 if idx == target_weak_idx else max_m
                st4.add_assessment(Assessment(subj, top, max_m, scored))
            self.students.append(st4)

    def get_questions_for_class(self, student_class: str) -> List[Question]:
        return [q for q in self.questions if q.target_class == student_class]

    def get_recommendations(self, student_class: str, weak_topics: List[tuple]) -> List[Resource]:
        recommended = []
        for subj, topic, _ in weak_topics:
            found = False
            for res in self.resources:
                if res.target_class == student_class and res.subject == subj and res.topic == topic:
                    recommended.append(res)
                    found = True
            # Fallback matching: if class-level match isn't present, match on subject + topic
            if not found:
                for res in self.resources:
                    if res.subject == subj and res.topic == topic:
                        recommended.append(res)
        return recommended

    def get_class_analytics(self, target_class: str):
        """Calculates statistics for a specific selected class grade."""
        class_students = [s for s in self.students if s.student_class == target_class]
        if not class_students:
            return 0.0, [], 0

        total_pct_sum = sum(s.get_overall_percentage() for s in class_students)
        avg_class_pct = total_pct_sum / len(class_students)

        weak_topic_counts = {}
        for s in class_students:
            _, weak = s.get_topic_breakdown()
            for subj, topic, _ in weak:
                key = f"{subj}: {topic}"
                weak_topic_counts[key] = weak_topic_counts.get(key, 0) + 1

        sorted_weak = sorted(weak_topic_counts.items(), key=lambda x: x[1], reverse=True)
        return avg_class_pct, sorted_weak, len(class_students)


