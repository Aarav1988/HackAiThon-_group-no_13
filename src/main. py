    def evaluate_and_show_report(self):
        topic_scores = {}

        for q in self.active_questions:
            key = (q.subject, q.topic)
            if key not in topic_scores:
                topic_scores[key] = {'scored': 0, 'max': 0}
            
            topic_scores[key]['max'] += 1
            if self.user_answers.get(q.q_id) == q.correct_idx:
                topic_scores[key]['scored'] += 1

        self.current_student.clear_assessments()
        for (subj, topic), data in topic_scores.items():
            asm = Assessment(subj, topic, data['max'], data['scored'])
            self.current_student.add_assessment(asm)

        self.show_reports_view()

