# 1. OOP, DATA MODELS
# ==========================================

class Question:
    """Stores question details along with target class level and options."""
    def __init__(self, q_id: int, target_class: str, subject: str, topic: str, text: str, options: List[str], correct_idx: int):
        self.q_id = q_id
        self.target_class = target_class
        self.subject = subject
        self.topic = topic
        self.text = text
        self.options = options
        self.correct_idx = correct_idx


class Resource:
    """Stores learning material details tagged with target class, subject, topic, and actual URL."""
    def __init__(self, res_id: str, target_class: str, subject: str, topic: str, title: str, url: str):
        self.res_id = res_id
        self.target_class = target_class
        self.subject = subject
        self.topic = topic
        self.title = title
        self.url = url


class Assessment:
    """Evaluates performance metrics for subject topics."""
    def __init__(self, subject: str, topic: str, max_marks: int, scored_marks: int):
        self.subject = subject
        self.topic = topic
        self.max_marks = max_marks
        self.scored_marks = scored_marks

    def get_percentage(self) -> float:
        return (self.scored_marks / self.max_marks) * 100 if self.max_marks > 0 else 0.0


class Student:
    """Holds student profile and assessment data."""
    def __init__(self, name: str, student_class: str):
        self.name = name
        self.student_class = student_class
        self.assessments: List[Assessment] = []

    def clear_assessments(self):
        self.assessments = []

    def add_assessment(self, assessment: Assessment):
        self.assessments.append(assessment)

    def get_total_scored(self) -> int:
        return sum(a.scored_marks for a in self.assessments)

    def get_total_max(self) -> int:
        return sum(a.max_marks for a in self.assessments)

    def get_overall_percentage(self) -> float:
        tot_max = self.get_total_max()
        return (self.get_total_scored() / tot_max * 100) if tot_max > 0 else 0.0

    def get_topic_breakdown(self):
        strong_topics = []
        weak_topics = []
        for asm in self.assessments:
            pct = asm.get_percentage()
            if pct < 60.0:
                weak_topics.append((asm.subject, asm.topic, pct))
            else:
                strong_topics.append((asm.subject, asm.topic, pct))
        return strong_topics, weak_topics


